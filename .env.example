APP_NAME=BC.GAME TRADE
APP_ENV=development
DATABASE_URL=sqlite:///./bcgame_trade.db
RUN_BACKGROUND_JOBS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=
ADMIN_CHAT_ID=

BCGAME_REGISTRATION_URL=
BCGAME_DEPOSIT_URL=
BCGAME_UPDOWN_URL=
SUPPORT_URL=

SIGNAL_MODE=PAPER
SIGNALS_ENABLED=false
BROADCASTS_ENABLED=false
DEFAULT_PAIR=BTCUSDT
DEFAULT_PRODUCT=BC_UPDOWN
DEFAULT_EXPIRY_SECONDS=300
STRATEGY_VERSION=BTC_UPDOWN_V1.0
SIGNAL_MIN_SCORE=6
SIGNAL_MIN_MARGIN=3
SIGNAL_TRADE_FLOW_LOOKBACK_SECONDS=30
SIGNAL_ENTRY_ALIGNMENT_SECONDS=60
SIGNAL_ENTRY_WINDOW_SECONDS=3
SIGNAL_MINIMUM_LEAD_SECONDS=15

MARKET_DATA_PROVIDER=BINANCE_SPOT
MARKET_DATA_REST_BASE_URL=https://api.binance.com
MARKET_DATA_WS_BASE_URL=wss://stream.binance.com:9443/ws
MARKET_DATA_MAX_AGE_SECONDS=3
MARKET_DATA_RECONNECT_SECONDS=3
MARKET_DATA_KLINE_LIMIT=300

TEMPORARY_RETENTION_DAYS=10
CLEANUP_INTERVAL_SECONDS=86400
