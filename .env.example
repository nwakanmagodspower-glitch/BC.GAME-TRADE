APP_NAME=BC.GAME TRADE
APP_ENV=development
DATABASE_URL=sqlite:///./bcgame_trade.db
RUN_BACKGROUND_JOBS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=1000000
TELEGRAM_UPDATE_PROCESSING_TIMEOUT_SECONDS=60
TELEGRAM_WEBHOOK_MAX_CONCURRENCY=32
TELEGRAM_WEBHOOK_QUEUE_TIMEOUT_SECONDS=0.25
TELEGRAM_USER_UPDATE_LIMIT=30
TELEGRAM_USER_UPDATE_WINDOW_SECONDS=10

BCGAME_REGISTRATION_URL=
BCGAME_DEPOSIT_URL=
BCGAME_UPDOWN_URL=https://bc.game/trading/up-down
SUPPORT_URL=

# Safe local/development defaults. render.yaml explicitly overrides the controlled beta to LIVE.
SIGNAL_MODE=PAPER
SIGNALS_ENABLED=false
BROADCASTS_ENABLED=false

GAME_MARKET=BTC/USD
ANALYSIS_PAIR=BTCUSDT
DEFAULT_PAIR=BTCUSDT
DEFAULT_PRODUCT=BC_UPDOWN_5S
DEFAULT_EXPIRY_SECONDS=5
DEFAULT_STAKE_BAND=1-50
STRATEGY_VERSION=BTC_UPDOWN_5S_V1.1

# Deployable V1 timing: user taps the button matching BC.GAME at 15/14/13/12s.
SIGNAL_TIMING_MODE=MANUAL_SYNC
MANUAL_SYNC_ALLOWED_COUNTDOWNS=15,14,13,12
MANUAL_SYNC_MIN_REMAINING_AFTER_SCAN=7
# Future automatic DeTrade/BC.GAME structured-round integration.
BCGAME_ROUND_SYNC_ENABLED=false
BCGAME_ROUND_SYNC_MAX_AGE_SECONDS=2

SIGNAL_MIN_SCORE=6
SIGNAL_MIN_MARGIN=3
SIGNAL_TRADE_FLOW_LOOKBACK_SECONDS=15
SIGNAL_MIN_RECENT_TRADES=12
SIGNAL_MIN_TICK_SPAN_SECONDS=4
SIGNAL_SCAN_COALESCE_MS=750
SIGNAL_USER_COOLDOWN_SECONDS=5
SIGNAL_SETTLEMENT_WINDOW_SECONDS=2
WORKER_HEARTBEAT_MAX_AGE_SECONDS=30

MARKET_DATA_PROVIDER=BINANCE_SPOT
MARKET_DATA_REST_BASE_URL=https://api.binance.com
MARKET_DATA_WS_BASE_URL=wss://stream.binance.com:9443/ws
MARKET_DATA_MAX_AGE_SECONDS=2
MARKET_DATA_RECONNECT_SECONDS=3
MARKET_DATA_KLINE_LIMIT=120
MARKET_DATA_REST_MAX_RESPONSE_BYTES=1000000
MARKET_CANDLE_REFRESH_SECONDS=15
MARKET_CANDLE_MAX_AGE_SECONDS=60
MARKET_DATA_FUTURE_SKEW_SECONDS=2

VERIFICATION_MAX_DEPOSIT_PROOFS=3
VERIFICATION_MAX_PHOTO_BYTES=10000000
VERIFICATION_MIN_EVIDENCE_INTERVAL_SECONDS=0.5
VERIFICATION_DELIVERY_MAX_ATTEMPTS=5

TEMPORARY_RETENTION_DAYS=10
CLEANUP_INTERVAL_SECONDS=86400
